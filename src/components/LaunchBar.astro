---
// Launch-day card for whichever NativeFirst app is on Product Hunt.
//
// Sits fixed in the bottom corner rather than as a bar above the header:
// the header is `fixed top-0` and every page is spaced to clear it, so a
// top bar would have shifted the layout of the whole site for one day.
//
// It removes itself. `ENDS` is the moment the Product Hunt day closes
// (00:01 PT + 24h), and past that this component renders nothing at all —
// no stale "launching today" left on the site because someone forgot.
const LAUNCH = {
  app: 'Whisperto',
  pitch: 'The meeting copilot only you can see',
  url: 'https://www.producthunt.com/products/whisperto?launch=whisperto&ref=nativefirstapp',
  ends: '2026-09-23T07:01:00Z',
};

const live = Date.now() < Date.parse(LAUNCH.ends);
---

{live && (
  <div
    id="launch-card"
    class="fixed bottom-4 right-4 z-[60] max-w-[calc(100vw-2rem)] w-[22rem] hidden"
  >
    <div class="relative rounded-2xl border border-border bg-surface/95 backdrop-blur p-4 shadow-2xl shadow-black/60">
      <button
        id="launch-dismiss"
        type="button"
        aria-label="Dismiss"
        class="absolute top-2.5 right-2.5 p-1.5 rounded-lg text-text-muted hover:text-white hover:bg-surface-2 transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>

      <p class="font-mono text-[11px] tracking-[0.14em] uppercase text-accent">
        Live on Product Hunt today
      </p>

      <p class="mt-2 text-white font-display font-bold text-lg leading-tight">
        {LAUNCH.app}
      </p>
      <p class="mt-1 text-sm text-text-muted leading-snug">
        {LAUNCH.pitch} — our new Mac app is launching right now.
      </p>

      <a
        href={LAUNCH.url}
        target="_blank"
        rel="noopener"
        class="mt-3.5 inline-flex items-center gap-2 w-full justify-center rounded-xl bg-accent px-4 py-2.5 font-nav text-sm font-semibold text-black hover:bg-accent-yellow transition-colors"
      >
        Take a look
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M7 7h10v10" />
        </svg>
      </a>
    </div>
  </div>

  <script is:inline define:vars={{ endsAt: LAUNCH.ends }}>
    (() => {
      const card = document.getElementById('launch-card');
      if (!card) return;
      // The page is cached and statically built, so re-check the clock on
      // the client too: a visitor served yesterday's HTML shouldn't be
      // told the launch is happening right now.
      if (Date.now() >= Date.parse(endsAt)) return;
      const KEY = 'nf-launch-dismissed-whisperto';
      try { if (localStorage.getItem(KEY)) return; } catch (e) { /* private window */ }
      card.classList.remove('hidden');
      document.getElementById('launch-dismiss')?.addEventListener('click', () => {
        card.remove();
        try { localStorage.setItem(KEY, '1'); } catch (e) { /* nothing to do */ }
      });
    })();
  </script>
)}
